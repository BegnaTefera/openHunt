# Core app
APP_NAME=openHunt
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=replace-me-with-a-strong-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Accounts. Sign-ups create regular accounts; provision admins with
# `python -m app.cli set-credentials you@example.com --admin`.
# Restrict sign-ups with ALLOWED_SIGNUP_EMAILS or disable them with SIGNUP_ENABLED=false.
SIGNUP_ENABLED=true
ALLOWED_SIGNUP_EMAILS=

# Database
POSTGRES_DB=openhunt
POSTGRES_USER=openhunt
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql+psycopg://openhunt:replace-with-local-database-password@localhost:5432/openhunt
COMPOSE_DATABASE_URL=postgresql+psycopg://openhunt:replace-with-local-database-password@db:5432/openhunt

# Outbound-request defaults for future integrations
JOB_FETCH_INTERVAL_MINUTES=30
MAX_JOBS_PER_RUN=50
REQUEST_TIMEOUT_SECONDS=20
REQUESTS_PER_MINUTE=20
USER_AGENT=openHunt/0.1 (+https://example.com; contact@example.com)
API_TIMEOUT_SECONDS=20

# Optional: company discovery. SerpApi's 250-search monthly cap is enforced by default.
COMMONCRAWL_ENABLED=true
SERPAPI_API_KEY=
SERPAPI_MONTHLY_CAP=250
SERPER_API_KEY=
SERPER_DAILY_CAP=20
SERPER_TOTAL_CAP=2000
DISCOVERY_MAX_QUERIES_PER_RUN=4
DISCOVERY_MAX_VALIDATIONS_PER_RUN=15

# Gmail reply tracking (Google OAuth; register this exact callback URL in Google Cloud).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
WEB_APP_URL=http://localhost:3000
GMAIL_POLL_INTERVAL_MINUTES=10

# Shared Telegram delivery destination. Configure both values to enable alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: free-tier AI for cover-letter drafting. The app works without these.
# Model names change over time; check each provider's current free models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Frontend
# Where the website's /api proxy forwards to (used when the frontend is built).
API_URL=http://localhost:8000
